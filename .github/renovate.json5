{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Pin GitHub Actions to a commit SHA with the tag in a trailing comment. That is the
    // only immutable form and what OpenSSF Scorecard's Pinned-Dependencies counts; see
    // .github/AGENTS.md. Without this, Renovate rewrites a pinned `uses:` back to a tag.
    "helpers:pinGitHubActionDigests",
  ],

  assignees: [
    "@A1994SC",
  ],

  ignoreUnstable: false,
  separateMajorMinor: false,
  dependencyDashboard: {
    "enabled": true,
    "autoclose": false,
    "title": "Dependency Dashboard",
    "header": "This issue lists Renovate updates and detected dependencies.",
    "osvVulnerabilitySummary": "unresolved",
    "reportAbandonment": true,
    "pinned": false,
    "customize": {}
  },

  // Every update is reviewed and merged by a person. Stated rather than left to the default,
  // so a preset added to `extends` above cannot quietly turn it on - `config:recommended`
  // does not, but several of the `:automergeX` presets do, and the grouped rules below would
  // then merge a whole family of modules on one green run.
  automerge: false,

  // Commit through the GitHub API rather than over git. Renovate recommends this when the
  // token is a GitHub App installation token, which is what .github/workflows/renovate.yaml
  // mints - it is also what gets the commits attributed to the app and signed by GitHub.
  // Drop it if this repository goes back to the hosted renovate[bot] app.
  platformCommit: "enabled",

  packageRules: [
    {
      matchDatasources: [
        "regex",
        "docker",
        "git-tags",
        "github-releases",
      ],
      addLabels: [
        "renovate/oci",
      ],
      groupName: "all dependencies",
      groupSlug: "all-dep",
      matchPackageNames: [
        "*",
      ],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: [
        "renovate/action",
      ],
      groupName: "all-actions",
      groupSlug: "all-actions",
      matchPackageNames: [
        "*",
      ],
    },
    // TEMPLATE: the three rules below are for a Go repository. Delete them in a repository
    // that has no go.mod.
    {
      matchManagers: ["gomod"],
      addLabels: [
        "renovate/gomod",
      ],
      groupName: "go modules",
      groupSlug: "all-gomod",
      matchPackageNames: [
        "*",
      ],
    },
    {
      matchManagers: ["pre-commit"],
      addLabels: [
        "renovate/pre-commit",
      ],
      groupName: "pre-commit hooks",
      groupSlug: "all-pre-commit",
    },
    // The only npm in the tree is the pinned commitlint CLI that the PR Title Check workflow
    // installs with `npm ci`. Grouped so its two packages, which share a version, move
    // together rather than as two pull requests that each fail until the other lands.
    {
      matchManagers: ["npm"],
      addLabels: [
        "renovate/npm",
      ],
      groupName: "commitlint",
      groupSlug: "commitlint",
    },
    // The `go` directive and the toolchain line are a decision about the language version,
    // not a dependency update, so they are not Renovate's to move.
    {
      matchDepTypes: ["golang"],
      enabled: false,
    },
  ],

  // A vendored tree has to be regenerated in the same commit, or the branch does not build.
  // Drop this in a repository that does not vendor.
  postUpdateOptions: [
    "gomodTidy",
    "gomodUpdateImportPaths",
  ],

  customManagers: [
    {
      customType: "regex",
      description: [
        "Process custom dependencies",
      ],
      managerFilePatterns: [
        "/(^|/).+\\.ya?ml(\\.j2)?$/",
      ],
      matchStrings: [
        "(?m:# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-0-9]+?))?( repository=(?<registryUrl>\\S+))?\n.+?: ?\"?.*(?<currentValue>\\S+?)\"?$)",
        "(?m:# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-0-9]+?))?( repository=(?<registryUrl>\\S+))?\n.+?(?<currentValue>(?:v|\\d|\\.)+)$)",
        "(?m:# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-0-9]+?))?\n.+?/(?<currentValue>(v|\\d)[^/]+)\\S+$)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    // TEMPLATE: this is how a pin that lives in a Go constant, a Dockerfile, or a JSON pins
    // file gets an owner rather than a bump procedure - see the "Pinned versions, digests,
    // and checksums" section of the root AGENTS.md. Annotate the line above the pin with
    // `// renovate: datasource=… depName=…` and Renovate moves it. Delete this block if
    // every pin in the repository is already in a file a real manager understands.
    {
      customType: "regex",
      description: [
        "Pins annotated in Go source, Dockerfiles, and shell scripts",
      ],
      managerFilePatterns: [
        "/(^|/).+\\.go$/",
        "/(^|/)Dockerfile[^/]*$/",
        "/(^|/).+\\.sh$/",
      ],
      matchStrings: [
        "(?m:(?:#|//) renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>[a-z-0-9]+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\n.*?\"?v?(?<currentValue>(?:\\d+\\.?)+(?:-\\S+)?)\"?.*$)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
}
